<Window x:Class="DiskCleanup.Views.ReviewWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review" Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">

        <!-- Step 1: review -->
        <Grid x:Name="ReviewPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="These items go to the Recycle Bin. You can still restore them from there." Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
            </StackPanel>
            <ItemsControl x:Name="WarningList" Grid.Row="1" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#78350F" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,6,0,10">
                <DataGrid x:Name="ReviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          HorizontalGridLinesBrush="{StaticResource Border}" Background="White" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Path}" Width="3*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel Grid.Row="3">
                <TextBlock x:Name="BinInfoText" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                <CheckBox x:Name="UnknownRoomBox" Visibility="Collapsed" Margin="0,0,0,6" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                          Content="I understand the Recycle Bin size could not be checked, so Windows might delete something permanently if the bin is full." />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
                <Button x:Name="MoveButton" Content="Move to Recycle Bin" Style="{StaticResource DangerButton}" Click="OnMove" />
            </StackPanel>
        </Grid>

        <!-- Step 2: working -->
        <StackPanel x:Name="WorkPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="Moving items to the Recycle Bin..." FontSize="18" FontWeight="SemiBold" />
            <ProgressBar IsIndeterminate="True" Height="8" Margin="0,14,0,10" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="WorkText" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Step 3: results -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultNote" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,10">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          HorizontalGridLinesBrush="{StaticResource Border}" Background="White" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Path}" Width="3*" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Moved" Binding="{Binding MovedText}" Width="80" />
                        <DataGridTextColumn Header="Left behind" Binding="{Binding LeftText}" Width="90" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Message}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Get the space back" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource TextMuted}"
                               Text="The space is only freed once the Recycle Bin is emptied. Emptying removes everything in that bin, including items that were there before today, and cannot be undone. Skip this if you want to keep the option to restore." />
                    <ItemsControl x:Name="BinList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Tag="{Binding Drive}" Click="OnEmptyBin"
                                            IsEnabled="{Binding CanEmpty}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Done, keep items in the Recycle Bin" Style="{StaticResource PrimaryButton}" Click="OnDone" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
